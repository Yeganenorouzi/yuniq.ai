{
	"name": "yeganenorouzi/yuniq-ai",
	"description": "Turn any WordPress site into an AI assistant that answers from your own content.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Yegane Norouzi",
			"homepage": "https://github.com/Yeganenorouzi",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"autoload": {
		"psr-4": {
			"Yuniq\\Ai\\": "src/"
		}
	},
	"scripts": {
		"lint": "phpcs --standard=WordPress --extensions=php --ignore=vendor/* .",
		"lint:fix": "phpcbf --standard=WordPress --extensions=php --ignore=vendor/* ."
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
